" vim version 9.2.10 +
" --- Look
set t_Co=256
syntax on
set background=dark
colorscheme catppuccin

hi Normal ctermbg=none

set laststatus=2
set hlsearch
set nowrap
set number
set relativenumber

" use: ctags -R --languages=XYZ and use ctrl-] to goto func def
set tags=./tags;,tags;

set cursorline
set cursorcolumn

hi cursorline ctermbg=236
hi cursorcolumn ctermbg=235
hi Visual ctermfg=20 cterm=bold ctermbg=207

" --- Behaviour
set clipboard=unnamedplus
set mouse=a
filetype indent on
set noesckeys
set scrolloff=4
set incsearch
set hidden
set autochdir
set shortmess-=S

let tabsz=4
let &tabstop=tabsz
let &shiftwidth=tabsz

set expandtab "XXX: turn off for makefiles n stuff

set wildmode=list:longest

let g:netrw_bufsettings = 'noma nomod nu nobl nowrap ro'

autocmd BufReadPost *
    \ if line("'\'") > 0 && line("'\'") <= line("$") |
    \   exe "normal! g`\"" |
    \ endif

" set unknown files to python syntax highlighting
autocmd BufReadPost,BufNewFile * if &filetype == '' | setfiletype python | endif

" --- Binds
imap <C-p> <Nop>

map <C-l> 5zl
map <C-h> 5zh

noremap <C-s> <C-x>
map <C-x> :b#<cr>

map n nzz
map N Nzz

"highlight word under cursor but dont jump to next
nnoremap * :let @/='\<'.expand('<cword>').'\>'<CR>:set hlsearch<CR>

map <C-s> :set spell!<cr>

"git blame the current line!
nnoremap <leader>b :echo system('git blame -L '.line('.').','.line('.').' '.expand('%'))<cr>
command! Blame :echo system('git blame -L '.line('.').','.line('.').' '.expand('%'))
